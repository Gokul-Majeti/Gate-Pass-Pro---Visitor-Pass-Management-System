# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection
# Provide a local MongoDB URI or MongoDB Atlas URI.
# Leave USE_IN_MEMORY_DB=true (or ALLOW_MEMORY_DB_FALLBACK=true) to run with an auto-seeded in-memory DB when local mongod is unavailable.
MONGODB_URI=mongodb://127.0.0.1:27017/visitor_pass_db
USE_IN_MEMORY_DB=false
ALLOW_MEMORY_DB_FALLBACK=true

# Security & Tokens
JWT_SECRET=replace_with_a_strong_32_char_secret_key
JWT_EXPIRES_IN=7d
QR_SIGNING_SECRET=replace_with_a_strong_qr_hmac_secret

# Frontend Origin
CLIENT_URL=http://localhost:5173

# File Uploads
UPLOAD_DIR=uploads
MAX_PHOTO_SIZE_MB=5

# Email (Nodemailer SMTP - optional; falls back to persistent Notification log & console preview if omitted)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GatePass Pro <noreply@gatepass.local>"

# SMS (Twilio - optional; falls back to persistent Notification log & console preview if omitted)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
